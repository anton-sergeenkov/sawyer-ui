{
  "name": "sawyer-ui",
  "private": false,
  "version": "0.4.0",
  "description": "Ui-Kit for Next.js: React components based on Mantine",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anton-sergeenkov/sawyer-ui.git"
  },
  "homepage": "https://anton-sergeenkov.github.io/sawyer-ui/",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "gh-pages": "gh-pages -d storybook-static",
    "deploy": "npm run build-storybook && npm run gh-pages && npm run commit",
    "commit": "git add . && git commit -m \"Bash Script Commit\" && git push origin head"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./fonts": {
      "types": "./dist/fonts.d.ts",
      "import": "./dist/fonts.js",
      "default": "./dist/fonts.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "dependencies": {
    "@mantine/core": "9.8.0",
    "@mantine/hooks": "9.8.0",
    "@phosphor-icons/react": "^2.1.10",
    "classnames": "^2.5.1"
  },
  "peerDependencies": {
    "next": ">=16",
    "react": ">=19.2",
    "react-dom": ">=19.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/nextjs-vite": "^10.6.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "^10.6.7",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "next": "^16.4.6",
    "prettier": "^3.10.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "storybook": "^10.6.7",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.3.8"
  }
}
